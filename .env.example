# AI Day Trader - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# ALPACA API (for trading & market data)
# Sign up at: https://alpaca.markets/
# ===========================================
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Use paper trading endpoint (recommended for testing)
# Paper: https://paper-api.alpaca.markets
# Live: https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ===========================================
# ANTHROPIC API (for Claude AI analysis)
# Sign up at: https://console.anthropic.com/
# ===========================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===========================================
# OPENAI API (backup/alternative)
# Sign up at: https://platform.openai.com/
# ===========================================
OPENAI_API_KEY=your_openai_api_key_here

# ===========================================
# TRADING MODE
# ===========================================
# IMPORTANT: Always start with "paper" mode!
# Only switch to "live" when you're confident
TRADING_MODE=paper
