# AI Day Trader - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# BINANCE API (for crypto trading)
# Sign up at: https://www.binance.com/
# For testnet: https://testnet.binance.vision/
# ===========================================
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Use testnet for paper trading (recommended for testing)
# Set to "true" for testnet, "false" for live trading
BINANCE_TESTNET=true

# ===========================================
# ALPACA API (for US stocks - optional)
# Sign up at: https://alpaca.markets/
# ===========================================
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ===========================================
# ANTHROPIC API (for Claude AI analysis)
# Sign up at: https://console.anthropic.com/
# ===========================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===========================================
# OPENAI API (backup/alternative)
# Sign up at: https://platform.openai.com/
# ===========================================
OPENAI_API_KEY=your_openai_api_key_here

# ===========================================
# TRADING MODE
# ===========================================
# IMPORTANT: Always start with "paper" mode!
TRADING_MODE=paper
